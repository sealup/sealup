# Strict install settings (decision 0010, ruling 12). npm 11.19 maps 0010's "allow-scripts for
# esbuild only" onto the `allowScripts` field of package.json; this file makes any other
# dependency's install script a hard error.
strict-allow-scripts=true
# Days a release must be public before npm installs it.
min-release-age=3
engine-strict=true
save-exact=true
