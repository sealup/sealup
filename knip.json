{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/*/index.ts",
    "src/cli/bin.ts",
    "src/action/bin.ts",
    "scripts/*.ts",
    "test/**/*.test.ts"
  ],
  "project": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts", "*.ts"],
  "ignore": ["test/gates/bad/**"],
  "ignoreDependencies": ["@biomejs/biome"],
  "includeEntryExports": true
}
