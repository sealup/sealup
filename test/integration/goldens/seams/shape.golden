}
export declare const maxFtpConnections = 16;
export declare function isFtp(protocol: ServerUrl['protocol']): boolean;
export type ConfigExpected = 'mapping' | 'text' | 'count' | 'connections' | 'fingerprint' | 'duration' | 'upload' | 'upload-entry' | 'targets' | 'target' | 'target-name' | 'allow' | 'patterns' | 'folder-exclude' | 'operations' | 'write' | 'write-entry' | 'mode' | 'yes-no' | 'pull';
export {};

// src/contracts/plan.ts
import type { RemotePath, ServerPath, Sha256 } from './brands.ts';
import type { AllowedRisk, Mapping } from './config.ts';
export interface LocalFile {
